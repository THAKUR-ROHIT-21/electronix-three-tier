pipeline {
    agent { 
        label 'electronic' 
    }

    environment {
        ECR_REPO      = '306158389325.dkr.ecr.ap-south-1.amazonaws.com/electronix-ecr'
        AWS_REGION    = 'ap-south-1'
        PRODUCTION_IP = '3.109.51.79'
    }

    stages {

        stage('Backend Pipeline') {

            // when {
            //     changeset "backend/**"
            // }

            stages {

                stage('Build Docker Image') {
                    steps {
                        dir("backend") {
                            sh '''
                            sudo docker build -t electronix-backend:${BUILD_NUMBER} .
                            '''
                        }
                    }
                }

                stage("Test ECR Login") {
                    steps {
                        sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | \
                        sudo docker login --username AWS --password-stdin 306158389325.dkr.ecr.ap-south-1.amazonaws.com
                        '''
                    }
                }

                stage('Tag & Push ECR') {
                    steps {
                        sh '''
                        sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                        sudo docker tag electronix-backend:${BUILD_NUMBER} ${ECR_REPO}:latest

                        sudo docker push ${ECR_REPO}:${BUILD_NUMBER}
                        sudo docker push ${ECR_REPO}:latest
                        '''
                    }
                }

                stage('Deploy To Production') {
                    steps {
                        sshagent(['prod-server-ssh-key']){
                        sh '''
                        ssh -o StrictHostKeyChecking=no ubuntu@${PRODUCTION_IP} "echo 'Connection Sussess'"
                        '''  
                        }
                    }
                }

            }
        }
    }

    post {

        success {
            echo "ECR login successfully ✅"
        }

        failure {
            echo "ECR login Failed ❌"
        }
    }
}